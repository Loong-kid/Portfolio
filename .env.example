# Google Sheets sync (optional)
# Method A: Public sheet URL — set GOOGLE_SHEET_ID and publish the sheet via
# File > Share > "Anyone with the link can view".
GOOGLE_SHEET_ID=

# Method B: Service account (private sheet, recommended)
# 1) Create a service account at console.cloud.google.com
# 2) Download JSON key and put the absolute path below
# 3) Share the sheet with the service account email
GOOGLE_SA_JSON=
GOOGLE_SHEET_NAME=transactions
